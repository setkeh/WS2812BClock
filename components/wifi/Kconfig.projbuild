menu "WS2812B Clock Wifi"

    config WIFI_SSID
        string "Wifi SSID"
        default ""
        help
            Wifi SSID

    config WIFI_PSK
        string "Wifi Password"
        default ""
        help
            Wiffi Passphrase / Pre-Shared Key

    config WIFI_MAXIMUM_RETRY
        int "Maximum retry"
        default 5
        help
            Set the Maximum retry to avoid station reconnecting to the AP unlimited when the AP is really inexistent.

endmenu
