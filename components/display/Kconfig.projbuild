menu "WS2812B Clock Display"

    config DISPLAY_RING_GPIO
        int "Ring data GPIO"
        range 0 39
        default 32

    config DISPLAY_RING_COUNT
        int "Ring pixel count"
        range 1 300
        default 60

    config DISPLAY_SEG_GPIO
        int "Seven-segment data GPIO"
        range 0 39
        default 25

    config DISPLAY_SEG_COUNT
        int "Seven-segment pixel count"
        range 1 300
        default 28

    config DISPLAY_ALTERNATE_DATE
        bool "Alternate the digits between time and date"
        default y
        help
            Shows HH MM for the first 30 s of each minute and DD MM for the
            rest. Turn off to show the time only.

    config DISPLAY_RING_DAY_BRIGHTNESS
        int "Ring daytime brightness (%)"
        range 1 100
        default 5

    config DISPLAY_RING_NIGHT_BRIGHTNESS
        int "Ring night-time brightness (%)"
        range 1 100
        default 1

    config DISPLAY_SEG_DAY_BRIGHTNESS
        int "Seven-segment daytime brightness (%)"
        range 1 100
        default 50

    config DISPLAY_SEG_NIGHT_BRIGHTNESS
        int "Seven-segment night-time brightness (%)"
        range 1 100
        default 5

    config DISPLAY_NIGHT_START_HOUR
        int "Night starts at hour (local, 0-23)"
        range 0 23
        default 19

    config DISPLAY_NIGHT_END_HOUR
        int "Night ends at hour (local, 0-23)"
        range 0 23
        default 6

    config DISPLAY_CYCLE_SECONDS
        int "Seconds per item on the centre display"
        depends on DISPLAY_ALTERNATE_DATE
        range 2 60
        default 10
        help
            The plates rotate through time, date, temperature and humidity, or
            just time and date when no sensor is fitted.

            A value that divides 86400 by the full cycle length leaves no jump
            at midnight: 10 seconds gives a 40 second cycle, and 86400 / 40 is
            exact. Awkward values still work, they just step once a day.

endmenu
